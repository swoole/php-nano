        },
        "reflection": {
          "extension": "reflection",
          "module-entry": "reflection_module_entry",
          "sources": ["ext/reflection/php_reflection.c"]
        },
        "random": {
          "extension": "random",
          "module-entry": "random_module_entry",
          "sources": [
            "ext/random/csprng.c", "ext/random/engine_mt19937.c",
            "ext/random/engine_pcgoneseq128xslrr64.c", "ext/random/engine_secure.c",
            "ext/random/engine_user.c", "ext/random/engine_xoshiro256starstar.c",
            "ext/random/gammasection.c", "ext/random/random.c",
            "ext/random/randomizer.c", "ext/random/zend_utils.c"

      "components": {
        "standard.core": {
          "extension": "standard",
          "module-entry": "basic_functions_module",
          "defines": ["PHP_NANO_STANDARD_CORE=1"],
          "sources": [
            "ext/standard/basic_functions.c"
          ]
        },
        "standard.array": {
          "extension": "standard",
          "module-entry": "basic_functions_module",
          "defines": ["PHP_NANO_STANDARD_ARRAY=1"],
          "requires": [
            "standard.core",
            "standard.string-api",
            "standard.math-api",
            "standard.type-api",
            "random"
          ]
        },
        "standard.string-api": {
          "extension": "standard",
          "sources": ["ext/standard/strnatcmp.c"]
        },
        "standard.string": {
          "extension": "standard",
          "module-entry": "basic_functions_module",
          "defines": ["PHP_NANO_STANDARD_STRING=1"],
          "requires": ["standard.core", "random"],
          "sources": ["ext/standard/strnatcmp.c"]
        },
        "standard.filesystem": {
          "extension": "standard",
          "module-entry": "basic_functions_module",
          "defines": ["PHP_NANO_STANDARD_FILESYSTEM=1"],
          "requires": ["standard.core", "random"],
          "sources": [
            "ext/standard/dir.c",
            "ext/standard/filestat.c",
            "ext/standard/streamsfuncs.c"
          ]
        },
        "standard.math": {
          "extension": "standard",
          "module-entry": "basic_functions_module",
          "defines": ["PHP_NANO_STANDARD_MATH=1"],
          "requires": ["standard.core"],
          "sources": ["ext/standard/math.c"]
        },
        "standard.math-api": {
          "extension": "standard",
          "sources": ["ext/standard/math.c"]
        },
        "standard.hash": {
          "extension": "standard",
          "module-entry": "basic_functions_module",
          "defines": ["PHP_NANO_STANDARD_HASH=1"],
          "requires": ["standard.core", "standard.filesystem"],
          "sources": [
            "ext/standard/md5.c",
            "ext/standard/sha1.c"
          ]
        },
        "standard.encoding": {
          "extension": "standard",
          "module-entry": "basic_functions_module",
          "defines": ["PHP_NANO_STANDARD_ENCODING=1"],
          "requires": ["standard.core"],
          "sources": ["ext/standard/base64.c"]
        },
        "standard.format": {
          "extension": "standard",
          "module-entry": "basic_functions_module",
          "defines": ["PHP_NANO_STANDARD_FORMAT=1"],
          "requires": ["standard.core"],
          "sources": ["ext/standard/formatted_print.c"]
        },
        "standard.var": {
          "extension": "standard",
          "module-entry": "basic_functions_module",
          "defines": ["PHP_NANO_STANDARD_VAR=1"],
          "requires": ["standard.core"],
          "sources": [
            "ext/standard/incomplete_class.c",
            "ext/standard/var.c",
            "ext/standard/var_unserializer.c"
          ]
        },
        "standard.info": {
          "extension": "standard",
          "module-entry": "basic_functions_module",
          "defines": ["PHP_NANO_STANDARD_INFO=1"],
          "requires": ["standard.core"],
          "sources": [
            "ext/standard/credits.c",
            "ext/standard/css.c",
            "ext/standard/info.c"
          ]
        },
        "standard.type": {
          "extension": "standard",
          "module-entry": "basic_functions_module",

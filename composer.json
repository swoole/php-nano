          "requires": ["standard.core"],
          "sources": ["ext/standard/type.c"]
        },
        "standard.type-api": {
          "extension": "standard",
          "sources": ["ext/standard/type.c"]
        },
        "standard.misc": {
          "extension": "standard",
          "module-entry": "basic_functions_module",
          "defines": ["PHP_NANO_STANDARD_MISC=1"],
          "requires": ["standard.core", "random"],
          "sources": ["ext/standard/versioning.c"]
        },
        "date": {
          "extension": "date",
          "module-entry": "date_module_entry",
          "sources": [
            "ext/date/php_date.c", "ext/date/php_time.c", "ext/date/time_duration.c",
            "ext/date/lib/astro.c", "ext/date/lib/dow.c", "ext/date/lib/duration.c",

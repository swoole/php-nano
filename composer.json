{
  "name": "swoole/php-nano",
  "description": "Minimal PHP-compatible native runtime sources for TypePHP",
  "type": "library",
  "license": "BSD-3-Clause",
  "require": {
    "php": ">=8.4"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "8.6.x-dev",
      "dev-master": "8.6.x-dev"
    },
    "typephp-native": {
      "kind": "runtime",
      "abi": 80600,
      "c-standard": 11,
      "cxx-standard": 17,
      "targets": [
        "linux",
        "macos",
        "ios",
        "android",
        "wasip2"
      ],
      "include-dirs": [
        ".",
        "Zend",
        "include",
        "main",
        "TSRM",
        "ext/date/lib",
        "ext/pcre/pcre2lib"
      ],
